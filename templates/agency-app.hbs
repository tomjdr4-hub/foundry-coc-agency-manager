<div class="coc-agency-root">
<nav class="coc-agency-tabs">
  <a class="coc-agency-tab {{#if (eq tab "sessions")}}active{{/if}}" data-action="setTab" data-tab="sessions">
    <i class="fa-solid fa-briefcase"></i> {{localize "COCAGENCY.Tabs.Sessions"}}
  </a>
  <a class="coc-agency-tab {{#if (eq tab "society")}}active{{/if}}" data-action="setTab" data-tab="society">
    <i class="fa-solid fa-building-columns"></i> {{localize "COCAGENCY.Tabs.Society"}}
  </a>
  {{#if isGM}}
  <a class="coc-agency-tab {{#if (eq tab "network")}}active{{/if}}" data-action="setTab" data-tab="network">
    <i class="fa-solid fa-diagram-project"></i> {{localize "COCAGENCY.Tabs.Network"}}
  </a>
  {{/if}}
  <a class="coc-agency-tab {{#if (eq tab "timeline")}}active{{/if}}" data-action="setTab" data-tab="timeline">
    <i class="fa-solid fa-timeline"></i> {{localize "COCAGENCY.Tabs.Timeline"}}
  </a>
  {{#if isGM}}
  <button type="button" class="coc-agency-worldclock" data-action="editWorldClock" title="{{localize 'COCAGENCY.Calendar.EditClock'}}">
    <i class="fa-solid fa-clock"></i> {{#if currentDateLabel}}{{currentDateLabel}}{{else}}{{localize "COCAGENCY.Calendar.SetClock"}}{{/if}}
  </button>
  {{else if currentDateLabel}}
  <span class="coc-agency-worldclock coc-agency-worldclock-readonly">
    <i class="fa-solid fa-clock"></i> {{currentDateLabel}}
  </span>
  {{/if}}
  <div class="coc-agency-nav-search">
    <i class="fa-solid fa-magnifying-glass"></i>
    <input type="text" data-search-input value="{{searchQuery}}" placeholder="{{localize 'COCAGENCY.Search.Placeholder'}}" />
    {{#if searchResults.length}}
    <div class="coc-agency-search-results">
      {{#each searchResults as |r|}}
      <div class="coc-agency-search-result" data-action="jumpToResult" data-type="{{r.type}}" data-session-id="{{r.sessionId}}" data-society-id="{{r.societyId}}" data-office-id="{{r.officeId}}">
        <strong>{{r.label}}</strong>
        <span>{{r.parent}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{#if isGM}}
  <div class="coc-agency-nav-actions">
    <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="exportData" title="{{localize 'COCAGENCY.Export.Export'}}">
      <i class="fa-solid fa-download"></i>
    </button>
    <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="importData" title="{{localize 'COCAGENCY.Export.Import'}}">
      <i class="fa-solid fa-upload"></i>
    </button>
    <input type="file" accept="application/json" data-file-input="import" hidden />
  </div>
  {{/if}}
</nav>

<section class="coc-agency-panel {{#if (eq tab "sessions")}}active{{/if}}" data-tab="sessions">
  <div class="coc-agency-columns">
    <aside class="coc-agency-list">
      {{#if isGM}}
      <button type="button" class="coc-agency-btn coc-agency-btn-block" data-action="createSession">
        <i class="fa-solid fa-plus"></i> {{localize "COCAGENCY.Session.Create"}}
      </button>
      {{/if}}
      <ul>
        {{#each sessions as |session|}}
        <li class="coc-agency-list-item {{#if (eq @root.selectedSessionId session.id)}}selected{{/if}}" data-action="selectSession" data-session-id="{{session.id}}">
          <span>{{session.name}}</span>
          {{#if @root.isGM}}
          <i class="fa-solid fa-trash coc-agency-icon-btn" data-action="deleteSession" data-session-id="{{session.id}}" title="{{localize 'COCAGENCY.Common.Delete'}}"></i>
          {{/if}}
        </li>
        {{else}}
        <li class="coc-agency-empty">{{localize "COCAGENCY.Session.Empty"}}</li>
        {{/each}}
      </ul>
    </aside>

    <div class="coc-agency-detail">
      {{#if selectedSession}}
      {{#with selectedSession}}
      <header class="coc-agency-detail-header">
        {{#if @root.isGM}}
        <input type="text" class="coc-agency-title-input" value="{{name}}" data-field="name" data-session-id="{{id}}" />
        {{else}}
        <h2>{{name}}</h2>
        {{/if}}
        <button type="button" class="coc-agency-btn" data-action="openSessionNotes" data-session-id="{{id}}">
          <i class="fa-solid fa-book"></i> {{localize "COCAGENCY.Session.Notes"}}
        </button>
      </header>

      <div class="coc-agency-session-date">
        {{#if @root.isGM}}
        <label>
          <i class="fa-solid fa-calendar-days"></i>
          <input type="datetime-local" value="{{date}}" data-field="date" data-session-id="{{id}}" />
        </label>
        {{else}}
        {{#if dateLabel}}
        <span><i class="fa-solid fa-calendar-days"></i> {{dateLabel}}</span>
        {{/if}}
        {{/if}}
      </div>

      {{#if @root.isGM}}
      <div class="coc-agency-scene-link">
        {{#each scenes as |scene|}}
        <span class="coc-agency-scene-chip">
          <i class="fa-solid fa-map-location-dot"></i> {{scene.name}}
          <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="activateScene" data-session-id="{{../id}}" data-scene-uuid="{{scene.uuid}}" title="{{localize 'COCAGENCY.Session.ActivateScene'}}">
            <i class="fa-solid fa-play"></i>
          </button>
          <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="unlinkScene" data-session-id="{{../id}}" data-scene-uuid="{{scene.uuid}}" title="{{localize 'COCAGENCY.Session.UnlinkScene'}}">
            <i class="fa-solid fa-link-slash"></i>
          </button>
        </span>
        {{/each}}
        <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="linkScene" data-session-id="{{id}}">
          <i class="fa-solid fa-link"></i> {{localize "COCAGENCY.Session.LinkScene"}}
        </button>
      </div>
      {{/if}}

      {{#if @root.isGM}}
      <textarea class="coc-agency-description" rows="2" placeholder="{{localize 'COCAGENCY.Session.RecapPlaceholder'}}" data-field="recap" data-session-id="{{id}}">{{recap}}</textarea>
      {{else}}
      {{#if recap}}<p class="coc-agency-description-readonly">{{recap}}</p>{{/if}}
      {{/if}}

      {{#if @root.isGM}}
      <div class="coc-agency-visibility">
        <span class="coc-agency-visibility-label">{{localize "COCAGENCY.Visibility.SessionLabel"}}</span>
        <label class="coc-agency-chip {{#if visibleAll}}active{{/if}}">
          <input type="checkbox" {{#if visibleAll}}checked{{/if}} data-action="toggleSessionAll" data-session-id="{{id}}" />
          {{localize "COCAGENCY.Visibility.All"}}
        </label>
        {{#each playerChecks as |p|}}
        <label class="coc-agency-chip {{#if p.checked}}active{{/if}}">
          <input type="checkbox" {{#if p.checked}}checked{{/if}} data-action="toggleSessionUser" data-session-id="{{../id}}" data-user-id="{{p.id}}" />
          {{p.name}}
        </label>
        {{/each}}
      </div>
      {{/if}}

      <div class="coc-agency-section">
        <div class="coc-agency-section-header">
          <h3><i class="fa-solid fa-image"></i> {{localize "COCAGENCY.Handout.Title"}}</h3>
          {{#if @root.isGM}}
          <div class="coc-agency-section-actions">
            <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="addHandoutImage" data-session-id="{{id}}">
              <i class="fa-solid fa-file-image"></i> {{localize "COCAGENCY.Handout.AddImage"}}
            </button>
            <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="addHandoutJournal" data-session-id="{{id}}">
              <i class="fa-solid fa-book-open"></i> {{localize "COCAGENCY.Handout.AddJournal"}}
            </button>
          </div>
          {{/if}}
        </div>
        <div class="coc-agency-cards">
          {{#each handouts as |h|}}
          <div class="coc-agency-card">
            {{#if h.isNew}}<span class="coc-agency-badge-new">{{localize "COCAGENCY.Common.New"}}</span>{{/if}}
            <div class="coc-agency-card-thumb">
              {{#if (eq h.kind "image")}}
              <img src="{{h.img}}" alt="{{h.title}}" />
              {{else}}
              <i class="fa-solid fa-book-open coc-agency-card-icon"></i>
              {{/if}}
            </div>
            <div class="coc-agency-card-body">
              <strong>{{h.title}}</strong>
              {{#if @root.isGM}}
              <span class="coc-agency-seen-count">{{localize "COCAGENCY.Common.SeenBy"}} {{h.seenCount}}/{{h.seenTotal}}</span>
              <div class="coc-agency-visibility">
                <label class="coc-agency-chip coc-agency-chip-sm {{#if h.visibleAll}}active{{/if}}">
                  <input type="checkbox" {{#if h.visibleAll}}checked{{/if}} data-action="toggleHandoutAll" data-session-id="{{h.sessionId}}" data-handout-id="{{h.id}}" />
                  {{localize "COCAGENCY.Visibility.All"}}
                </label>
                {{#each h.playerChecks as |p|}}
                <label class="coc-agency-chip coc-agency-chip-sm {{#if p.checked}}active{{/if}}">
                  <input type="checkbox" {{#if p.checked}}checked{{/if}} data-action="toggleHandoutUser" data-session-id="{{h.sessionId}}" data-handout-id="{{h.id}}" data-user-id="{{p.id}}" />
                  {{p.name}}
                </label>
                {{/each}}
              </div>
              {{/if}}
            </div>
            <div class="coc-agency-card-actions">
              <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="showHandout" data-session-id="{{h.sessionId}}" data-handout-id="{{h.id}}" title="{{localize 'COCAGENCY.Handout.Show'}}">
                <i class="fa-solid fa-eye"></i>
              </button>
              {{#if @root.isGM}}
              <button type="button" class="coc-agency-btn coc-agency-btn-sm coc-agency-btn-danger" data-action="deleteHandout" data-session-id="{{h.sessionId}}" data-handout-id="{{h.id}}" title="{{localize 'COCAGENCY.Common.Delete'}}">
                <i class="fa-solid fa-trash"></i>
              </button>
              {{/if}}
            </div>
          </div>
          {{else}}
          <p class="coc-agency-empty">{{localize "COCAGENCY.Handout.Empty"}}</p>
          {{/each}}
        </div>
      </div>

      {{#if @root.isGM}}
      {{#if revealLog.length}}
      <div class="coc-agency-section">
        <div class="coc-agency-section-header">
          <h3><i class="fa-solid fa-clock-rotate-left"></i> {{localize "COCAGENCY.Session.RevealLog"}}</h3>
        </div>
        <ul class="coc-agency-reveal-log">
          {{#each revealLog as |entry|}}
          <li><strong>{{entry.handoutTitle}}</strong> — {{entry.targets}} <span class="coc-agency-reveal-date">{{entry.at}}</span></li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
      {{/if}}

      <div class="coc-agency-section">
        <div class="coc-agency-section-header">
          <h3><i class="fa-solid fa-people-group"></i> {{localize "COCAGENCY.Npc.Title"}}</h3>
        </div>
        {{#if @root.isGM}}
        <div class="coc-agency-dropzone" data-dropzone="session-npc" data-session-id="{{id}}">
          <i class="fa-solid fa-arrow-pointer"></i> {{localize "COCAGENCY.Npc.DropHint"}}
        </div>
        {{/if}}
        <div class="coc-agency-cards">
          {{#each npcs as |n|}}
          <div class="coc-agency-card">
            {{#if n.isNew}}<span class="coc-agency-badge-new">{{localize "COCAGENCY.Common.New"}}</span>{{/if}}
            <div class="coc-agency-card-thumb">
              <img src="{{n.img}}" alt="{{n.name}}" />
            </div>
            <div class="coc-agency-card-body">
              <strong>
                {{#if n.canOpen}}
                <a data-action="openActorSheet" data-actor-uuid="{{n.actorUuid}}">{{n.name}}</a>
                {{else}}
                {{n.name}}
                {{/if}}
              </strong>
              {{#if @root.isGM}}
              <span class="coc-agency-seen-count">{{localize "COCAGENCY.Common.SeenBy"}} {{n.seenCount}}/{{n.seenTotal}}</span>
              <textarea class="coc-agency-note" rows="2" placeholder="{{localize 'COCAGENCY.Npc.NotePlaceholder'}}" data-field="note" data-session-id="{{n.sessionId}}" data-npc-id="{{n.id}}">{{n.note}}</textarea>
              <div class="coc-agency-visibility">
                <label class="coc-agency-chip coc-agency-chip-sm {{#if n.visibleAll}}active{{/if}}">
                  <input type="checkbox" {{#if n.visibleAll}}checked{{/if}} data-action="toggleNpcAll" data-session-id="{{n.sessionId}}" data-npc-id="{{n.id}}" />
                  {{localize "COCAGENCY.Visibility.All"}}
                </label>
                {{#each n.playerChecks as |p|}}
                <label class="coc-agency-chip coc-agency-chip-sm {{#if p.checked}}active{{/if}}">
                  <input type="checkbox" {{#if p.checked}}checked{{/if}} data-action="toggleNpcUser" data-session-id="{{n.sessionId}}" data-npc-id="{{n.id}}" data-user-id="{{p.id}}" />
                  {{p.name}}
                </label>
                {{/each}}
              </div>
              {{else}}
              {{#if n.note}}<p class="coc-agency-note-readonly">{{n.note}}</p>{{/if}}
              {{/if}}
            </div>
            <div class="coc-agency-card-actions">
              <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="openNpcNotes" data-session-id="{{n.sessionId}}" data-npc-id="{{n.id}}" title="{{localize 'COCAGENCY.Npc.MyNotes'}}">
                <i class="fa-solid fa-note-sticky"></i>
              </button>
              {{#if @root.isGM}}
              <button type="button" class="coc-agency-btn coc-agency-btn-sm coc-agency-btn-danger" data-action="removeNpc" data-session-id="{{n.sessionId}}" data-npc-id="{{n.id}}" title="{{localize 'COCAGENCY.Common.Delete'}}">
                <i class="fa-solid fa-trash"></i>
              </button>
              {{/if}}
            </div>
          </div>
          {{else}}
          <p class="coc-agency-empty">{{localize "COCAGENCY.Npc.Empty"}}</p>
          {{/each}}
        </div>
      </div>
      {{/with}}
      {{else}}
      <p class="coc-agency-empty">{{localize "COCAGENCY.Session.SelectPrompt"}}</p>
      {{/if}}
    </div>
  </div>
</section>

<section class="coc-agency-panel {{#if (eq tab "society")}}active{{/if}}" data-tab="society">
  <div class="coc-agency-columns">
    <aside class="coc-agency-list">
      {{#if isGM}}
      <button type="button" class="coc-agency-btn coc-agency-btn-block" data-action="createSociety">
        <i class="fa-solid fa-plus"></i> {{localize "COCAGENCY.Society.Create"}}
      </button>
      {{/if}}
      <ul>
        {{#each societies as |society|}}
        <li class="coc-agency-list-item {{#if (eq @root.selectedSocietyId society.id)}}selected{{/if}}" data-action="selectSociety" data-society-id="{{society.id}}">
          <span>{{society.name}}</span>
          {{#if @root.isGM}}
          <i class="fa-solid fa-trash coc-agency-icon-btn" data-action="deleteSociety" data-society-id="{{society.id}}" title="{{localize 'COCAGENCY.Common.Delete'}}"></i>
          {{/if}}
        </li>
        {{else}}
        <li class="coc-agency-empty">{{localize "COCAGENCY.Society.Empty"}}</li>
        {{/each}}
      </ul>
    </aside>

    <div class="coc-agency-detail">
      {{#if selectedSociety}}
      {{#with selectedSociety}}
      <header class="coc-agency-detail-header">
        {{#if @root.isGM}}
        <input type="text" class="coc-agency-title-input" value="{{name}}" data-field="name" data-society-id="{{id}}" />
        <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="setSocietyImage" data-society-id="{{id}}">
          <i class="fa-solid fa-image"></i> {{localize "COCAGENCY.Society.SetImage"}}
        </button>
        <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="setSocietyMap" data-society-id="{{id}}">
          <i class="fa-solid fa-map"></i> {{localize "COCAGENCY.Society.SetMap"}}
        </button>
        {{else}}
        <h2>{{name}}</h2>
        {{/if}}
      </header>
      {{#if @root.isGM}}
      <textarea class="coc-agency-description" rows="2" placeholder="{{localize 'COCAGENCY.Society.DescriptionPlaceholder'}}" data-field="description" data-society-id="{{id}}">{{description}}</textarea>
      {{else}}
      {{#if description}}<p class="coc-agency-description-readonly">{{description}}</p>{{/if}}
      {{/if}}

      <div class="coc-agency-society-layout">
        <div class="coc-agency-map-wrapper">
          {{#if mapImage}}
          <div class="coc-agency-map {{#if @root.placingOffice}}placing{{/if}}" data-map data-society-id="{{id}}" style="background-image: url('{{mapImage}}');">
            {{#each offices as |o|}}
            {{#if o.hasPin}}
            <button type="button" class="coc-agency-pin {{#if (eq @root.selectedOfficeId o.id)}}selected{{/if}}" style="left: {{o.x}}%; top: {{o.y}}%;" data-action="selectOffice" data-society-id="{{o.societyId}}" data-office-id="{{o.id}}" title="{{o.name}}">
              <i class="fa-solid fa-location-dot"></i>
            </button>
            {{/if}}
            {{/each}}
          </div>
          {{else}}
          <div class="coc-agency-map-placeholder">
            <i class="fa-solid fa-earth-europe"></i>
            <p>{{localize "COCAGENCY.Society.NoMap"}}</p>
          </div>
          {{/if}}
        </div>

        <div class="coc-agency-office-panel">
          <div class="coc-agency-section-header">
            <h3><i class="fa-solid fa-building"></i> {{localize "COCAGENCY.Office.Title"}}</h3>
            {{#if @root.isGM}}
            <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="addOffice" data-society-id="{{id}}">
              <i class="fa-solid fa-plus"></i> {{localize "COCAGENCY.Office.Create"}}
            </button>
            {{/if}}
          </div>
          <ul class="coc-agency-office-list">
            {{#each offices as |o|}}
            <li class="coc-agency-list-item {{#if (eq @root.selectedOfficeId o.id)}}selected{{/if}}" data-action="selectOffice" data-society-id="{{o.societyId}}" data-office-id="{{o.id}}">
              <span>{{o.name}}{{#if o.location}} — {{o.location}}{{/if}}</span>
              {{#if @root.isGM}}
              <i class="fa-solid fa-trash coc-agency-icon-btn" data-action="deleteOffice" data-society-id="{{o.societyId}}" data-office-id="{{o.id}}" title="{{localize 'COCAGENCY.Common.Delete'}}"></i>
              {{/if}}
            </li>
            {{else}}
            <li class="coc-agency-empty">{{localize "COCAGENCY.Office.Empty"}}</li>
            {{/each}}
          </ul>

          {{#if @root.selectedOffice}}
          {{#with @root.selectedOffice}}
          <div class="coc-agency-office-detail">
            {{#if @root.isGM}}
            <input type="text" class="coc-agency-title-input" value="{{name}}" data-field="name" data-society-id="{{societyId}}" data-office-id="{{id}}" placeholder="{{localize 'COCAGENCY.Office.NewName'}}" />
            <input type="text" class="coc-agency-subtitle-input" value="{{location}}" data-field="location" data-society-id="{{societyId}}" data-office-id="{{id}}" placeholder="{{localize 'COCAGENCY.Office.LocationPlaceholder'}}" />
            <textarea class="coc-agency-description" rows="3" placeholder="{{localize 'COCAGENCY.Office.DescriptionPlaceholder'}}" data-field="description" data-society-id="{{societyId}}" data-office-id="{{id}}">{{description}}</textarea>
            <div class="coc-agency-section-actions">
              <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="setOfficeImage" data-society-id="{{societyId}}" data-office-id="{{id}}">
                <i class="fa-solid fa-image"></i> {{localize "COCAGENCY.Office.SetImage"}}
              </button>
              <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="startPlacingOffice">
                <i class="fa-solid fa-map-pin"></i> {{localize "COCAGENCY.Office.PlacePin"}}
              </button>
            </div>
            <div class="coc-agency-visibility">
              <label class="coc-agency-chip {{#if visibleAll}}active{{/if}}">
                <input type="checkbox" {{#if visibleAll}}checked{{/if}} data-action="toggleOfficeAll" data-society-id="{{societyId}}" data-office-id="{{id}}" />
                {{localize "COCAGENCY.Visibility.All"}}
              </label>
              {{#each playerChecks as |p|}}
              <label class="coc-agency-chip {{#if p.checked}}active{{/if}}">
                <input type="checkbox" {{#if p.checked}}checked{{/if}} data-action="toggleOfficeUser" data-society-id="{{../societyId}}" data-office-id="{{../id}}" data-user-id="{{p.id}}" />
                {{p.name}}
              </label>
              {{/each}}
            </div>
            {{else}}
            <h4>{{name}}{{#if location}} — {{location}}{{/if}}</h4>
            {{#if description}}<p>{{description}}</p>{{/if}}
            {{/if}}

            {{#if img}}<img class="coc-agency-office-image" src="{{img}}" alt="{{name}}" />{{/if}}

            <div class="coc-agency-section-header">
              <h4><i class="fa-solid fa-people-group"></i> {{localize "COCAGENCY.Office.Staff"}}</h4>
            </div>
            {{#if @root.isGM}}
            <div class="coc-agency-dropzone" data-dropzone="office-npc" data-society-id="{{societyId}}" data-office-id="{{id}}">
              <i class="fa-solid fa-arrow-pointer"></i> {{localize "COCAGENCY.Npc.DropHint"}}
            </div>
            {{/if}}
            <div class="coc-agency-cards">
              {{#each npcs as |n|}}
              <div class="coc-agency-card coc-agency-card-compact">
                <div class="coc-agency-card-thumb"><img src="{{n.img}}" alt="{{n.name}}" /></div>
                <div class="coc-agency-card-body"><strong>{{n.name}}</strong></div>
                {{#if @root.isGM}}
                <div class="coc-agency-card-actions">
                  <button type="button" class="coc-agency-btn coc-agency-btn-sm coc-agency-btn-danger" data-action="removeOfficeNpc" data-society-id="{{../societyId}}" data-office-id="{{../id}}" data-actor-uuid="{{n.uuid}}" title="{{localize 'COCAGENCY.Common.Delete'}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
                {{/if}}
              </div>
              {{else}}
              <p class="coc-agency-empty">{{localize "COCAGENCY.Office.NoStaff"}}</p>
              {{/each}}
            </div>

            <div class="coc-agency-section-header">
              <h4><i class="fa-solid fa-user-tie"></i> {{localize "COCAGENCY.Office.Assigned"}}</h4>
            </div>
            {{#if @root.isGM}}
            <div class="coc-agency-dropzone" data-dropzone="office-assignment" data-society-id="{{societyId}}" data-office-id="{{id}}">
              <i class="fa-solid fa-arrow-pointer"></i> {{localize "COCAGENCY.Office.AssignedDropHint"}}
            </div>
            {{/if}}
            <div class="coc-agency-cards">
              {{#each assignedActors as |a|}}
              <div class="coc-agency-card coc-agency-card-compact {{#if a.isMine}}coc-agency-card-mine{{/if}}">
                <div class="coc-agency-card-thumb"><img src="{{a.img}}" alt="{{a.name}}" /></div>
                <div class="coc-agency-card-body">
                  <strong>{{a.name}}</strong>
                  {{#if a.isMine}}<span class="coc-agency-mine-label">{{localize "COCAGENCY.Office.YourCharacter"}}</span>{{/if}}
                </div>
                {{#if @root.isGM}}
                <div class="coc-agency-card-actions">
                  <button type="button" class="coc-agency-btn coc-agency-btn-sm coc-agency-btn-danger" data-action="removeOfficeAssignment" data-society-id="{{../societyId}}" data-office-id="{{../id}}" data-actor-uuid="{{a.uuid}}" title="{{localize 'COCAGENCY.Common.Delete'}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
                {{/if}}
              </div>
              {{else}}
              <p class="coc-agency-empty">{{localize "COCAGENCY.Office.NoAssigned"}}</p>
              {{/each}}
            </div>
          </div>
          {{/with}}
          {{/if}}
        </div>
      </div>

      <div class="coc-agency-section">
        <div class="coc-agency-section-header">
          <h3><i class="fa-solid fa-box-archive"></i> {{localize "COCAGENCY.Equipment.Title"}}</h3>
        </div>
        {{#if @root.isGM}}
        <div class="coc-agency-dropzone" data-dropzone="equipment" data-society-id="{{id}}">
          <i class="fa-solid fa-arrow-pointer"></i> {{localize "COCAGENCY.Equipment.DropHint"}}
        </div>
        {{/if}}
        <div class="coc-agency-cards">
          {{#each equipment as |e|}}
          <div class="coc-agency-card">
            <div class="coc-agency-card-thumb">
              <img src="{{e.img}}" alt="{{e.name}}" />
            </div>
            <div class="coc-agency-card-body">
              <strong>{{e.name}}</strong>
              {{#if @root.isGM}}
              <textarea class="coc-agency-note" rows="2" placeholder="{{localize 'COCAGENCY.Equipment.NotePlaceholder'}}" data-field="note" data-society-id="{{e.societyId}}" data-item-id="{{e.id}}">{{e.note}}</textarea>
              {{else}}
              {{#if e.note}}<p class="coc-agency-note-readonly">{{e.note}}</p>{{/if}}
              {{/if}}
            </div>
            <div class="coc-agency-card-actions">
              <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="orderEquipment" data-society-id="{{e.societyId}}" data-item-id="{{e.id}}">
                <i class="fa-solid fa-cart-shopping"></i> {{localize "COCAGENCY.Equipment.Order"}}
              </button>
              {{#if @root.isGM}}
              <button type="button" class="coc-agency-btn coc-agency-btn-sm coc-agency-btn-danger" data-action="deleteEquipmentItem" data-society-id="{{e.societyId}}" data-item-id="{{e.id}}">
                <i class="fa-solid fa-trash"></i>
              </button>
              {{/if}}
            </div>
          </div>
          {{else}}
          <p class="coc-agency-empty">{{localize "COCAGENCY.Equipment.Empty"}}</p>
          {{/each}}
        </div>

        {{#if orders.length}}
        <table class="coc-agency-orders">
          <thead>
            <tr>
              <th>{{localize "COCAGENCY.Equipment.Item"}}</th>
              {{#if @root.isGM}}<th>{{localize "COCAGENCY.Equipment.RequestedBy"}}</th>{{/if}}
              <th>{{localize "COCAGENCY.Equipment.Status"}}</th>
              <th>{{localize "COCAGENCY.Equipment.Eta"}}</th>
              {{#if @root.isGM}}<th></th>{{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each orders as |o|}}
            <tr>
              <td>{{o.itemName}}</td>
              {{#if @root.isGM}}<td>{{o.requestedByName}}</td>{{/if}}
              <td>
                {{#if @root.isGM}}
                <span class="coc-agency-order-status coc-agency-order-status-{{o.status}}">{{o.statusLabel}}</span>
                <div class="coc-agency-order-status-buttons">
                  <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="setOrderStatus" data-society-id="{{o.societyId}}" data-order-id="{{o.id}}" data-status="approved">{{localize "COCAGENCY.Equipment.StatusApproved"}}</button>
                  <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="setOrderStatus" data-society-id="{{o.societyId}}" data-order-id="{{o.id}}" data-status="delivered">{{localize "COCAGENCY.Equipment.StatusDelivered"}}</button>
                  <button type="button" class="coc-agency-btn coc-agency-btn-sm coc-agency-btn-danger" data-action="setOrderStatus" data-society-id="{{o.societyId}}" data-order-id="{{o.id}}" data-status="denied">{{localize "COCAGENCY.Equipment.StatusDenied"}}</button>
                </div>
                {{else}}
                <span class="coc-agency-order-status coc-agency-order-status-{{o.status}}">{{o.statusLabel}}</span>
                {{/if}}
              </td>
              <td>
                {{#if @root.isGM}}
                <input type="text" value="{{o.eta}}" data-field="eta" data-society-id="{{o.societyId}}" data-order-id="{{o.id}}" placeholder="{{localize 'COCAGENCY.Equipment.EtaPlaceholder'}}" />
                {{else}}
                {{o.eta}}
                {{/if}}
              </td>
              {{#if @root.isGM}}
              <td><i class="fa-solid fa-trash coc-agency-icon-btn" data-action="deleteOrder" data-society-id="{{o.societyId}}" data-order-id="{{o.id}}"></i></td>
              {{/if}}
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{/if}}
      </div>
      {{/with}}
      {{else}}
      <p class="coc-agency-empty">{{localize "COCAGENCY.Society.SelectPrompt"}}</p>
      {{/if}}
    </div>
  </div>
</section>

{{#if isGM}}
<section class="coc-agency-panel {{#if (eq tab "network")}}active{{/if}}" data-tab="network">
  <div class="coc-agency-network">
    <div class="coc-agency-section-actions coc-agency-network-actions">
      <button type="button" class="coc-agency-btn coc-agency-btn-sm" data-action="addRelationship">
        <i class="fa-solid fa-plus"></i> {{localize "COCAGENCY.Network.AddRelationship"}}
      </button>
    </div>
    {{#if network.hasNodes}}
    <div class="coc-agency-network-graph">
      <svg class="coc-agency-network-svg" preserveAspectRatio="none">
        {{#each network.edges as |edge|}}
        <line x1="{{edge.x1}}%" y1="{{edge.y1}}%" x2="{{edge.x2}}%" y2="{{edge.y2}}%" />
        <text x="{{edge.midX}}%" y="{{edge.midY}}%">{{edge.label}}</text>
        {{/each}}
      </svg>
      {{#each network.nodes as |node|}}
      <div class="coc-agency-network-node" style="left: {{node.x}}%; top: {{node.y}}%;">
        {{#if node.canOpen}}
        <img src="{{node.img}}" alt="{{node.name}}" data-action="openActorSheet" data-actor-uuid="{{node.actorUuid}}" />
        {{else}}
        <img src="{{node.img}}" alt="{{node.name}}" />
        {{/if}}
        <span>{{node.name}}</span>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="coc-agency-empty">{{localize "COCAGENCY.Network.Empty"}}</p>
    {{/if}}
    <ul class="coc-agency-relationship-list">
      {{#each network.edges as |edge|}}
      <li>{{edge.label}} <i class="fa-solid fa-trash coc-agency-icon-btn" data-action="deleteRelationship" data-relationship-id="{{edge.id}}"></i></li>
      {{/each}}
    </ul>
  </div>
</section>
{{/if}}

<section class="coc-agency-panel {{#if (eq tab "timeline")}}active{{/if}}" data-tab="timeline">
  <div class="coc-agency-timeline">
    {{#each timelineSessions as |session|}}
    <div class="coc-agency-timeline-entry">
      <h3>{{session.name}}</h3>
      {{#if session.dateLabel}}<p class="coc-agency-timeline-date"><i class="fa-solid fa-calendar-days"></i> {{session.dateLabel}}</p>{{/if}}
      <p>{{session.recap}}</p>
    </div>
    {{else}}
    <p class="coc-agency-empty">{{localize "COCAGENCY.Timeline.Empty"}}</p>
    {{/each}}
  </div>
</section>
</div>
